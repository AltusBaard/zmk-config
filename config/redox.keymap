  #include <behaviors.dtsi>
  #include <dt-bindings/zmk/keys.h>
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/ext_power.h>

  / {
    keymap {
      compatible = "zmk,keymap";
  layer0 {
          bindings = <
          &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp ESCAPE &kp SINGLE_QUOTE &kp COMMA &kp DOT &kp P &kp Y &lt 1 F20 &lt 1 F20 &kp F &kp G &kp C &kp R &kp L &kp EQUAL &kp TAB &kp A &kp O &kp E &kp U &kp I &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp D &kp H &kp T &kp N &kp S &kp RIGHT_CONTROL &kp LEFT_SHIFT &kp SEMICOLON &kp Q &kp J &kp K &kp X &kp PAGE_DOWN &kp PAGE_UP &kp HOME &kp END &kp B &kp M &kp W &kp V &kp Z &kp RIGHT_SHIFT &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &kp SLASH &kp BACKSLASH &kp ENTER &kp DELETE &kp BACKSPACE &kp SPACE &kp K_APPLICATION &kp LEFT &kp DOWN &kp UP &kp RIGHT
          >;
        };layer1 {
          bindings = <
          &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans [[KC_EXLM]] [[KC_AT]] [[KC_LCBR]] [[KC_RCBR]] [[KC_PIPE]] &trans &trans &kp KP_SLASH &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp C_REWIND &kp C_FAST_FORWARD &trans [[KC_HASH]] [[KC_DLR]] &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp GRAVE [[LCA(KC_DEL)]] &trans &kp KP_ASTERISK &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp C_STOP &kp C_PLAY_PAUSE &trans [[KC_PERC]] [[KC_CIRC]] [[KC_LPRN]] [[KC_RPRN]] [[KC_TILD]] &kp LC(X) &kp LC(C) &kp LC(C) &kp LC(X) &none &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp C_VOLUME_DOWN &kp C_VOLUME_UP &trans &trans &trans &trans &trans &trans &kp LC(V) &kp LC(V) &trans &kp KP_N0 &kp KP_N0 &kp KP_DOT &kp C_MUTE &none
          >;
        };layer2 {
          bindings = <
          &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &none &none [[KC_MS_U]] &none [[KC_WH_U]] &none &trans &trans &none &none &none &none &none &none &none [[KC_MS_L]] [[KC_MS_D]] [[KC_MS_R]] [[KC_WH_D]] &none &trans &trans &kp LEFT &kp DOWN &kp UP &kp RIGHT &none &none &none &none &none &none &none &none &trans &trans &trans &none &none &none &none &none &none &none &none &none &none &none [[KC_BTN1]] [[KC_BTN2]] &trans &trans &trans &none &none &none &none &none
          >;
        };layer3 {
          bindings = <
          &none &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none &none [[QK_BOOT]] [[RGB_M_P]] [[RGB_TOG]] [[RGB_MOD]] [[RGB_HUD]] [[RGB_HUI]] [[RGB_SAD]] [[RGB_SAI]] [[RGB_VAD]] [[RGB_VAI]] &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &trans &none &none &trans &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none
          >;
        };
    };
  };
  